---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RoadmapItem from '../../components/RoadmapItem.astro';
import { fetchRoadmapChildren, fetchRoadmapGroups, type RoadmapChild } from '../../lib/roadmap';

export async function getStaticPaths() {
  const children = await fetchRoadmapChildren();
  return children.map((child) => ({
    params: { slug: child.slug },
    props: { child },
  }));
}

interface Props {
  child: RoadmapChild;
}

const { child } = Astro.props;
const groups = await fetchRoadmapGroups(child.id);
const items = groups.flatMap((g) => g.items);
const shippedCount = items.filter((item) => item.statusClass === 'shipped').length;
// Only meaningful while a semester is underway (some shipped, some not) —
// "11 of 11 shipped" on a fully-shipped page would just be noise.
const showProgress = shippedCount > 0 && shippedCount < items.length;
---

<Layout
  title={`${child.title} — Roadmap — Docs`}
  description={`Part of the Docs roadmap: ${child.title}.`}
>
  <Header current="roadmap" />

<main id="top">

  <section class="article" style="padding-bottom:32px;">
    <div class="wrap">
      <a href="/roadmap.html" class="back-link">← Back to the roadmap</a>
      <h1 class="reveal in">{child.title}</h1>
      {showProgress && (
        <div class="roadmap-progress reveal in">
          <span><strong>{shippedCount} of {items.length}</strong> shipped so far</span>
          <span class="roadmap-progress-bar" role="presentation"><span style={`width:${(shippedCount / items.length) * 100}%`}></span></span>
        </div>
      )}
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap">
      {groups.map((group) => (
        <div class="roadmap-group">
          {group.heading && <h2 class="roadmap-group-title">{group.heading}</h2>}
          <div class="roadmap-list">
            {group.items.map((item) => <RoadmapItem item={item} />)}
          </div>
        </div>
      ))}
    </div>
  </section>

</main>

  <Footer current="roadmap" />
</Layout>
